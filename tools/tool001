<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tool001</title>
    <style>
        body {
            font-family: 'Poppins', sans-serif;
            background-color: #f4f4f9;
            text-align: center;
            margin: 20px;
        }

        h2 {
            color: #333;
        }

        .container {
            background: white;
            padding: 20px;
            max-width: 400px;
            margin: auto;
            box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.1);
            border-radius: 10px;
        }

        input, textarea {
            width: 100%;
            padding: 12px;
            margin-bottom: 10px;
            font-size: 16px;
            border: 1px solid #ccc;
            border-radius: 5px;
            outline: none;
            transition: 0.3s;
        }

        input:focus, textarea:focus {
            border-color: #007bff;
            box-shadow: 0px 0px 5px rgba(0, 123, 255, 0.5);
        }

        button {
            width: 100%;
            padding: 12px;
            margin-top: 10px;
            font-size: 16px;
            font-weight: bold;
            color: white;
            background: linear-gradient(45deg, #007bff, #00d4ff);
            border: none;
            border-radius: 5px;
            cursor: pointer;
            transition: 0.3s;
        }

        button:hover {
            background: linear-gradient(45deg, #0056b3, #008cff);
            transform: scale(1.05);
        }

        .search-box {
            margin-top: 15px;
        }

        .output-buttons {
            margin-top: 15px;
        }

        .output-buttons button {
            width: 100%;
            margin: 5px 0;
            background: #28a745;
            font-size: 14px;
            transition: 0.3s;
        }

        .output-buttons button:hover {
            background: #218838;
            transform: scale(1.05);
        }

        .hidden {
            display: none;
        }
    </style>
</head>
<body>

    
    <div class="container">
        <input type="text" id="inputBox" placeholder="Enter main subject" value="Elephant">
        <textarea id="textArea" placeholder="Enter styles, comma-separated">Cartoon, 3D Rendered, Cyberpunk</textarea>
        <button onclick="generateButtons()">Generate Styles</button>
        
        <input type="text" id="searchBox" class="search-box" onkeyup="filterButtons()" placeholder="Search styles...">
    </div>

    <div class="output-buttons" id="output"></div>

    <script>
        function generateButtons() {
            let inputValue = document.getElementById("inputBox").value.trim();
            let textValues = document.getElementById("textArea").value.split(",").map(v => v.trim()).filter(v => v);
            let outputDiv = document.getElementById("output");

            outputDiv.innerHTML = "";
            textValues.forEach(style => {
                let btn = document.createElement("button");
                let text = ${inputValue} style: ${style};
                btn.innerText = text;
                btn.onclick = () => copyToClipboard(text);
                outputDiv.appendChild(btn);
            });

            document.getElementById("searchBox").style.display = textValues.length ? "block" : "none";
        }

        function copyToClipboard(text) {
            navigator.clipboard.writeText(text).then(() => {
                alert(Copied: ${text});
            });
        }

        function filterButtons() {
            let searchValue = document.getElementById("searchBox").value.toLowerCase();
            let buttons = document.querySelectorAll(".output-buttons button");

            buttons.forEach(btn => {
                if (btn.innerText.toLowerCase().includes(searchValue)) {
                    btn.classList.remove("hidden");
                } else {
                    btn.classList.add("hidden");
                }
            });
        }
    </script>
</body>
</html>
